{
  "name": "Weekly Check-in Reminder",
  "nodes": [
    { "name": "Every Monday 8AM IST", "type": "n8n-nodes-base.scheduleTrigger", "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 0 8 * * 1" }] } }, "position": [0, 0] },
    { "name": "Get Eligible Clients", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/weekly-checkin", "method": "POST", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] } }, "position": [240, 0] },
    { "name": "Send WhatsApp Check-in Reminder", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.WAHA_URL }}/api/sendText", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }] }, "bodyParameters": { "parameters": [{ "name": "session", "value": "={{ $env.WAHA_SESSION }}" }, { "name": "chatId", "value": "={{ $json.phone }}@c.us" }, { "name": "text", "value": "={{ 'Hi ' + $json.display_name + ' — time for your weekly check-in. Please update your progress here: ' + $env.APP_URL + '/checkin' }}" }] } }, "position": [500, 0] },
    { "name": "Mark Check-in Sent", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/mark-checkin-sent", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] }, "bodyParameters": { "parameters": [{ "name": "client_id", "value": "={{ $('Get Eligible Clients').item.json.id }}" }] } }, "position": [760, 0] }
  ],
  "connections": { "Every Monday 8AM IST": { "main": [[{ "node": "Get Eligible Clients", "type": "main", "index": 0 }]] }, "Get Eligible Clients": { "main": [[{ "node": "Send WhatsApp Check-in Reminder", "type": "main", "index": 0 }]] }, "Send WhatsApp Check-in Reminder": { "main": [[{ "node": "Mark Check-in Sent", "type": "main", "index": 0 }]] } },
  "settings": { "timezone": "Asia/Kolkata" }
}
