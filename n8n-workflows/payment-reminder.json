{
  "name": "Payment Reminder",
  "nodes": [
    { "name": "Every Day 10AM IST", "type": "n8n-nodes-base.scheduleTrigger", "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 0 10 * * *" }] } }, "position": [0, 0] },
    { "name": "Get Due Reminders", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/pending-payments", "method": "POST", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] } }, "position": [220, 0] },
    { "name": "Build Payment Message", "type": "n8n-nodes-base.code", "typeVersion": 2, "parameters": { "jsCode": "return items.map(({ json }) => ({ json: { ...json, event_type: 'payment_reminder_' + json.days_overdue, message: 'Hi ' + json.display_name + ' 🙂 Your payment of ₹' + json.amount + ' is ' + json.days_overdue + ' days overdue. Please clear it at your earliest convenience.\\n\\nPay here: ' + $env.APP_URL + '/client/payments' } }));" }, "position": [440, 0] },
    { "name": "Send WhatsApp Payment Reminder", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.WAHA_URL }}/api/sendText", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }] }, "bodyParameters": { "parameters": [{ "name": "session", "value": "={{ $env.WAHA_SESSION }}" }, { "name": "chatId", "value": "={{ $json.phone }}@c.us" }, { "name": "text", "value": "={{ $json.message }}" }] } }, "position": [660, 0] },
    { "name": "Send Payment Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/send-email", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] }, "bodyParameters": { "parameters": [{ "name": "type", "value": "payment_reminder" }, { "name": "to", "value": "={{ $('Build Payment Message').item.json.email }}" }, { "name": "name", "value": "={{ $('Build Payment Message').item.json.display_name }}" }, { "name": "amount", "value": "={{ $('Build Payment Message').item.json.amount }}" }, { "name": "dueDate", "value": "={{ $('Build Payment Message').item.json.dueDate }}" }, { "name": "dayNumber", "value": "={{ $('Build Payment Message').item.json.days_overdue }}" }] } }, "position": [880, 0] },
    { "name": "Mark Payment Reminder Delivered", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/mark-reminder-sent", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] }, "bodyParameters": { "parameters": [{ "name": "entity_type", "value": "fee" }, { "name": "entity_id", "value": "={{ $('Build Payment Message').item.json.id }}" }, { "name": "client_id", "value": "={{ $('Build Payment Message').item.json.client_id }}" }, { "name": "event_type", "value": "={{ $('Build Payment Message').item.json.event_type }}" }] } }, "position": [1100, 0] }
  ],
  "connections": { "Every Day 10AM IST": { "main": [[{ "node": "Get Due Reminders", "type": "main", "index": 0 }]] }, "Get Due Reminders": { "main": [[{ "node": "Build Payment Message", "type": "main", "index": 0 }]] }, "Build Payment Message": { "main": [[{ "node": "Send WhatsApp Payment Reminder", "type": "main", "index": 0 }]] }, "Send WhatsApp Payment Reminder": { "main": [[{ "node": "Send Payment Email", "type": "main", "index": 0 }]] }, "Send Payment Email": { "main": [[{ "node": "Mark Payment Reminder Delivered", "type": "main", "index": 0 }]] } },
  "settings": { "timezone": "Asia/Kolkata" }
}
