{
  "name": "Plan Expiry Reminder",
  "nodes": [
    {
      "name": "Cron: Every Day 9AM IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "ruleData": {
          "interval": [{ "field": "cron", "expression": "30 3 * * *" }]
        }
      },
      "position": [0, 0]
    },
    {
      "name": "Get Expiring Plans",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/automation/expiring-plans",
        "method": "POST",
        "headerParameters": {
          "parameters": [
            { "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }
          ]
        }
      },
      "position": [200, 0]
    },
    {
      "name": "Loop Over Expiring Clients",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": { "batchSize": 1 },
      "position": [400, 0]
    },
    {
      "name": "IF: 7 Days Left",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{ $json.days_left }}", "operation": "equal", "value2": 7 }
          ]
        }
      },
      "position": [600, 0]
    },
    {
      "name": "WhatsApp 7 Days",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chatId", "value": "={{ $json.phone }}@c.us" },
            { "name": "text", "value": "={{ 'Hi ' + $json.display_name + ' 👋 Your plan expires in 7 days. Renew now to continue your transformation journey!\n\nRenew here: ' + $env.APP_URL + '/client/payments' }}" }
          ]
        }
      },
      "position": [800, 0]
    },
    {
      "name": "Email 7 Days",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/automation/send-email",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "plan_expiry" },
            { "name": "to", "value": "={{ $json.email }}" },
            { "name": "name", "value": "={{ $json.display_name }}" },
            { "name": "expiryDate", "value": "={{ $json.expiry_date }}" },
            { "name": "daysLeft", "value": 7 }
          ]
        },
        "headerParameters": {
          "parameters": [
            { "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }
          ]
        }
      },
      "position": [1000, 0]
    },
    {
      "name": "IF: 3 Days Left",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{ $json.days_left }}", "operation": "equal", "value2": 3 }
          ]
        }
      },
      "position": [600, 400]
    },
    {
      "name": "WhatsApp 3 Days",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chatId", "value": "={{ $json.phone }}@c.us" },
            { "name": "text", "value": "={{ 'Hi ' + $json.display_name + ' ⏰ Your plan expires in just 3 days! Don\'t lose access to your personalized plans. Renew today.\n\nRenew here: ' + $env.APP_URL + '/client/payments' }}" }
          ]
        }
      },
      "position": [800, 400]
    },
    {
      "name": "Email 3 Days",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/automation/send-email",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "plan_expiry" },
            { "name": "to", "value": "={{ $json.email }}" },
            { "name": "name", "value": "={{ $json.display_name }}" },
            { "name": "expiryDate", "value": "={{ $json.expiry_date }}" },
            { "name": "daysLeft", "value": 3 }
          ]
        },
        "headerParameters": {
          "parameters": [
            { "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }
          ]
        }
      },
      "position": [1000, 400]
    },
    {
      "name": "IF: Expired Today (0 Days)",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{ $json.days_left }}", "operation": "equal", "value2": 0 }
          ]
        }
      },
      "position": [600, 800]
    },
    {
      "name": "WhatsApp Expired",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chatId", "value": "={{ $json.phone }}@c.us" },
            { "name": "text", "value": "={{ 'Hi ' + $json.display_name + ' 🚨 Your plan has expired today! Renew now to continue your fitness journey without missing a day.\n\nRenew here: ' + $env.APP_URL + '/client/payments' }}" }
          ]
        }
      },
      "position": [800, 800]
    },
    {
      "name": "Email Expired",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/automation/send-email",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "plan_expiry" },
            { "name": "to", "value": "={{ $json.email }}" },
            { "name": "name", "value": "={{ $json.display_name }}" },
            { "name": "expiryDate", "value": "={{ $json.expiry_date }}" },
            { "name": "daysLeft", "value": 0 }
          ]
        },
        "headerParameters": {
          "parameters": [
            { "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }
          ]
        }
      },
      "position": [1000, 800]
    }
  ],
  "connections": {
    "Cron: Every Day 9AM IST": { "main": [[ { "node": "Get Expiring Plans", "type": "main", "index": 0 } ]] },
    "Get Expiring Plans": { "main": [[ { "node": "Loop Over Expiring Clients", "type": "main", "index": 0 } ]] },
    "Loop Over Expiring Clients": { "main": [[ { "node": "IF: 7 Days Left", "type": "main", "index": 0 } ]] },
    "IF: 7 Days Left": { "main": [[ { "node": "WhatsApp 7 Days", "type": "main", "index": 0 } ]] },
    "WhatsApp 7 Days": { "main": [[ { "node": "Email 7 Days", "type": "main", "index": 0 } ]] },
    "IF: 3 Days Left": { "main": [[ { "node": "WhatsApp 3 Days", "type": "main", "index": 0 } ]] },
    "WhatsApp 3 Days": { "main": [[ { "node": "Email 3 Days", "type": "main", "index": 0 } ]] },
    "IF: Expired Today (0 Days)": { "main": [[ { "node": "WhatsApp Expired", "type": "main", "index": 0 } ]] },
    "WhatsApp Expired": { "main": [[ { "node": "Email Expired", "type": "main", "index": 0 } ]] }
  }
}
