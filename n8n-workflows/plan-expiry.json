{
  "name": "Plan Expiry Reminder",
  "nodes": [
    { "name": "Every Day 9AM IST", "type": "n8n-nodes-base.scheduleTrigger", "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 0 9 * * *" }] } }, "position": [0, 0] },
    { "name": "Get Due Plan Reminders", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/expiring-plans", "method": "POST", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] } }, "position": [220, 0] },
    { "name": "Build Plan Message", "type": "n8n-nodes-base.code", "typeVersion": 2, "parameters": { "jsCode": "return items.map(({ json }) => { const label = json.days_left === 0 ? 'has expired today' : 'expires in ' + json.days_left + ' days'; return { json: { ...json, event_type: 'plan_expiry_' + json.days_left, message: 'Hi ' + json.display_name + ' 👋 Your plan ' + label + '. Renew here: ' + $env.APP_URL + '/client/payments' } }; });" }, "position": [440, 0] },
    { "name": "Send WhatsApp Plan Reminder", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.WAHA_URL }}/api/sendText", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }] }, "bodyParameters": { "parameters": [{ "name": "session", "value": "={{ $env.WAHA_SESSION }}" }, { "name": "chatId", "value": "={{ $json.phone }}@c.us" }, { "name": "text", "value": "={{ $json.message }}" }] } }, "position": [660, 0] },
    { "name": "Send Plan Email", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/send-email", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] }, "bodyParameters": { "parameters": [{ "name": "type", "value": "plan_expiry" }, { "name": "to", "value": "={{ $('Build Plan Message').item.json.email }}" }, { "name": "name", "value": "={{ $('Build Plan Message').item.json.display_name }}" }, { "name": "expiryDate", "value": "={{ $('Build Plan Message').item.json.expiry_date }}" }, { "name": "daysLeft", "value": "={{ $('Build Plan Message').item.json.days_left }}" }] } }, "position": [880, 0] },
    { "name": "Mark Plan Reminder Delivered", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "parameters": { "url": "={{ $env.APP_URL }}/api/automation/mark-reminder-sent", "method": "POST", "sendHeaders": true, "sendBody": true, "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] }, "bodyParameters": { "parameters": [{ "name": "entity_type", "value": "plan" }, { "name": "entity_id", "value": "={{ $('Build Plan Message').item.json.id }}" }, { "name": "client_id", "value": "={{ $('Build Plan Message').item.json.client_id }}" }, { "name": "event_type", "value": "={{ $('Build Plan Message').item.json.event_type }}" }] } }, "position": [1100, 0] }
  ],
  "connections": { "Every Day 9AM IST": { "main": [[{ "node": "Get Due Plan Reminders", "type": "main", "index": 0 }]] }, "Get Due Plan Reminders": { "main": [[{ "node": "Build Plan Message", "type": "main", "index": 0 }]] }, "Build Plan Message": { "main": [[{ "node": "Send WhatsApp Plan Reminder", "type": "main", "index": 0 }]] }, "Send WhatsApp Plan Reminder": { "main": [[{ "node": "Send Plan Email", "type": "main", "index": 0 }]] }, "Send Plan Email": { "main": [[{ "node": "Mark Plan Reminder Delivered", "type": "main", "index": 0 }]] } },
  "settings": { "timezone": "Asia/Kolkata" }
}
